{
  "name": "inkduel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --config worker/wrangler.toml --port 8787 --ip 0.0.0.0",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json --noEmit",
    "sim": "node scripts/simulate.mjs",
    "deploy:api": "wrangler deploy --config worker/wrangler.toml",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name=inkduel --commit-dirty=true",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "wrangler": "^4.148.0"
  }
}
